# ============================================
# PARENTAL CONTROL AGENT — CẤU HÌNH MẪU
# Sao chép file này thành .env và điền giá trị thực
# ============================================

# ── Kết nối Backend (BẮT BUỘC - Điền URL thật của máy chủ) ──
BACKEND_URL=https://nguyentruclam.io.vn
WS_URL=wss://nguyentruclam.io.vn

# ── Failover (tùy chọn, khuyên dùng) ──
# Khi WS về máy nhà mất kết nối, agent poll lệnh từ URL này mỗi 30s.
# Mặc định trỏ về chính nguyentruclam.io.vn (Cloudflare Worker đã xử lý home→backup).
BACKUP_SERVER_URL=https://nguyentruclam.io.vn

# ── Xác thực (BẮT BUỘC — lấy từ file backend_api/.env trên Server) ──
API_KEY=<đặt_api_key_thật_ở_đây>

# ── Thông báo Telegram (tùy chọn) ──
TELEGRAM_BOT_TOKEN=<token_bot_telegram_của_bạn>
TELEGRAM_CHAT_ID=<chat_id_của_bạn>

# ── Cấu hình Agent (BẮT BUỘC) ──
DEVICE_NAME=May_Em_Trai
AGENT_PASSWORD=<mật_khẩu_mạnh_để_mở_màn_hình_khóa>

# ── Tốc độ đồng bộ (giây, mặc định 5) ──
SEND_INTERVAL=5