{
  "buildCommand": "cd manager-web && npm install && npm run build",
  "outputDirectory": "manager-web/dist",
  "framework": null,
  "builds": [
    {
      "src": "backend_api/api/index.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    { "source": "/api/:path*",    "destination": "/backend_api/api/index.py" },
    { "source": "/ws/:path*",     "destination": "/backend_api/api/index.py" },
    { "source": "/static/:path*", "destination": "/backend_api/api/index.py" },
    { "source": "/(.*)",          "destination": "/index.html" }
  ]
}
