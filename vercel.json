{
  "buildCommand": "cd manager-web && npm install && npm run build",
  "outputDirectory": "manager-web/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*",    "destination": "https://quanlypc-api-backup.vercel.app/api/:path*" },
    { "source": "/ws/:path*",     "destination": "https://quanlypc-api-backup.vercel.app/ws/:path*" },
    { "source": "/static/:path*", "destination": "https://quanlypc-api-backup.vercel.app/static/:path*" },
    { "source": "/(.*)",          "destination": "/index.html" }
  ]
}
