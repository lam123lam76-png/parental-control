{
  "buildCommand": "cd manager-web && npm install && npm run build",
  "outputDirectory": "manager-web/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)",    "destination": "/api/index.py" },
    { "source": "/ws/(.*)",     "destination": "/api/index.py" },
    { "source": "/static/(.*)", "destination": "/api/index.py" },
    { "source": "/(.*)",        "destination": "/index.html" }
  ]
}
